# ganti yomi.example.com dengan domainmu; Caddy mengurus HTTPS otomatis
yomi.example.com {
	root * /var/www/yomi
	encode zstd gzip
	try_files {path} /index.html
	file_server

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@shell path /sw.js /index.html /manifest.webmanifest /registerSW.js
	header @shell Cache-Control "no-cache"
}
